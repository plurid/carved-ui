{
  "name": "carved-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @carved/storybook dev",
    "dev:site": "pnpm --filter @carved/site dev",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build": "pnpm build:packages && pnpm --filter @carved/storybook build && pnpm --filter @carved/site build",
    "lint": "eslint --config tools/config/eslint.config.mjs packages apps tools docs && stylelint --config tools/config/stylelint.config.mjs \"packages/*/src/**/*.css\" \"apps/*/src/**/*.css\" \"apps/storybook/.storybook/*.css\" \"docs/examples/*.css\"",
    "format": "prettier --write --ignore-path .gitignore --ignore-path tools/config/prettier-ignore .",
    "format:check": "prettier --check --ignore-path .gitignore --ignore-path tools/config/prettier-ignore .",
    "typecheck": "pnpm --filter @plurid/carved-ui-core build && pnpm -r typecheck && tsc -p tools/config/tsconfig.tests.json",
    "test": "vitest run --config tools/config/vitest.config.ts",
    "test:stories": "pnpm --filter @carved/storybook test",
    "test:browser": "playwright test --config tools/config/playwright.config.ts --grep-invert @visual",
    "test:visual": "playwright test --config tools/config/playwright.config.ts --grep @visual",
    "verify:packages": "node tools/tests/packages.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:stories && pnpm test:browser && pnpm verify:packages",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@plurid/carved-ui-core": "workspace:*",
    "@plurid/carved-ui-react": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/culori": "4.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "lightningcss": "1.33.0",
    "next": "16.3.7",
    "prettier": "3.9.9",
    "publint": "0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "10.6.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
