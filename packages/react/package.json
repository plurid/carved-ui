{
  "name": "@plurid/carved-ui-react",
  "version": "1.0.0-next.0",
  "description": "Accessible React components in the Carved material: surfaces cut into one material, lit by one light",
  "keywords": [
    "carved",
    "react",
    "components",
    "design-system",
    "react-aria",
    "accessibility"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plurid/carved-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://plurid.github.io/carved-ui/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node ../../tools/build/clean.mjs react && tsc -p tsconfig.json && node ../../tools/build/styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@plurid/carved-ui-core": "workspace:^",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
